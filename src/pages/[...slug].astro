---
import BaseLayout from '../layouts/BaseLayout.astro';
import RichPage from '../components/RichPage.astro';
import pages from '../data/source-pages.json';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.path }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} meta={page.meta}>
  <RichPage page={page} />
</BaseLayout>
