---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  meta?: Array<Record<string, string | undefined>>;
}

const { title, description, meta = [] } = Astro.props;
const sourceMetadata = meta.filter((entry) => entry.content && (entry.property || entry.name) && !['robots', 'viewport', 'description', 'generator'].includes(entry.name ?? ''));
const sourceDescription = meta.find((entry) => entry.name === 'description')?.content;
const canonical = meta.find((entry) => entry.rel === 'canonical')?.href;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    {(description || sourceDescription) && <meta name="description" content={sourceDescription || description} />}
    {sourceMetadata.map((entry) => <meta name={entry.name} property={entry.property} content={entry.content} />)}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/assets/original/icono-estenio.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
