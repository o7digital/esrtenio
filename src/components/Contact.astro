<section class="contact" id="contacto">
  <div class="wrap">
    <div>
      <div class="label">CONVERSEMOS</div>
      <h2>El siguiente paso<br />empieza contigo.</h2>
      <p>Cuéntanos qué necesitas resolver. Cada buena estrategia comienza con una conversación.</p>
      <div class="details">
        <a href="tel:+525556820573">+52 (55) 5682 0573 ↗</a>
        <a href="mailto:info@estenio.com.mx">info@estenio.com.mx ↗</a>
        <span>Cracovia 72, San Ángel<br />Ciudad de México</span>
      </div>
    </div>
    <form id="contact-form">
      <label>Nombre<input required name="name" autocomplete="name" placeholder="Tu nombre" /></label>
      <label>Correo electrónico<input required type="email" name="email" autocomplete="email" placeholder="tu@empresa.com" /></label>
      <label>Empresa<input name="company" autocomplete="organization" placeholder="Opcional" /></label>
      <label>Teléfono<input type="tel" name="phone" autocomplete="tel" placeholder="+52" /></label>
      <label class="full">¿En qué podemos ayudarte?<textarea required name="message" placeholder="Describe brevemente tu situación"></textarea></label>
      <p class="demo-note full">Formulario de demostración. No se envían ni guardan datos.</p>
      <button class="btn full" type="submit">Probar solicitud de contacto <span>↗</span></button>
      <div class="status full" role="status" id="status"></div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (status) status.textContent = 'Demostración completada. No se ha enviado ninguna solicitud.';
  });
</script>
