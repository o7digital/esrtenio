---
import PreviewContact from './PreviewContact.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import SourceTabs from './SourceTabs.astro';
interface Props { page: any; }
const { page } = Astro.props;
---
<SiteHeader />
<main id="content">
  <section class="page-hero">
    {page.heroImage && <img class="page-hero-image" src={page.heroImage.src} alt="" fetchpriority="high" />}
    <div class="wrap"><h1>{page.heading}</h1></div>
  </section>
  <article class="content-page wrap">
    <section class:list={['page-intro', { 'with-image': page.introImage }]}>
      <div><h2>{page.leadTitle}</h2>{page.leadSubtitle && <p class="lead-subtitle">{page.leadSubtitle}</p>}<div class="rich-copy" set:html={page.introHTML} /></div>
      {page.introImage && <img class="intro-image" src={page.introImage.src} alt={page.introImage.alt} loading="lazy" />}
    </section>
    {page.historyImages.length > 0 && <div class="history-images">{page.historyImages.map((image: any) => <img src={image.src} alt={image.alt} loading="lazy" />)}</div>}
    {page.values.length > 0 && <section class="content-section"><h2>VALORES</h2><div class="rich-copy" set:html={page.valuesIntro} /><div class="values-grid">{page.values.map((value: any) => <article><img src={value.image.src} alt={value.image.alt} loading="lazy" /><h3>{value.title}</h3><div class="rich-copy" set:html={value.html} /></article>)}</div></section>}
    {page.team.length > 0 && <section class="content-section team-section"><h2>NUESTRO EQUIPO</h2>{page.teamImage && <img class="team-photo" src={page.teamImage.src} alt="" loading="lazy" />}<div class="team-grid">{page.team.map((member: any) => <article class="team-card">{member.image && <img src={member.image.src} alt={member.name} loading="lazy" />}<div><h3>{member.name}</h3><p>{member.role}</p></div></article>)}</div></section>}
    {page.closing && <p class="closing-line">{page.closing}</p>}
    {page.tabs.length > 0 && <SourceTabs tabs={page.tabs} />}
    {page.cards.length > 0 && <section class="content-section"><h2>{page.extraTitle}</h2><div class="service-list">{page.cards.map((card: any) => <details><summary>{card.image && <img src={card.image.src} alt="" loading="lazy" />}<span><strong>{card.frontTitle}</strong><small>{card.frontLabel}</small></span></summary><div class="service-card-body"><h3>{card.title}</h3><div class="rich-copy" set:html={card.html} /></div></details>)}</div></section>}
    {page.steps.length > 0 && <section class="content-section"><h2>{page.stepTitle}</h2><div class="rich-copy" set:html={page.stepIntro} /><div class="steps-list">{page.steps.map((step: any) => <article><span class="step-number">{step.number}</span><div><h3>{step.title}</h3><div class="rich-copy" set:html={step.html} /></div></article>)}</div></section>}
    {page.features.length > 0 && <section class="content-section feature-list">{page.features.map((feature: any) => <article>{feature.image && <img src={feature.image.src} alt="" loading="lazy" />}<div><h3>{feature.title}</h3><div class="rich-copy" set:html={feature.html} /></div></article>)}</section>}
    {page.webinar && <section class="webinar"><img src={page.webinar.image.src} alt={page.webinar.image.alt} loading="lazy" /><h2>{page.webinar.title}</h2><a class="button" href={page.webinar.href}>ASISTIR</a></section>}
    {page.services.length > 0 && <section class="content-section"><h2>{page.servicesHeading}</h2><div class="services-with-image">{page.servicesImage && <img src={page.servicesImage.src} alt="" loading="lazy" />}<div class="faq-list">{page.services.map((service: any) => <details><summary>{service.title}</summary><div class="rich-copy" set:html={service.html} /></details>)}</div></div></section>}
    {page.testimonials.length > 0 && <section class="content-section"><h2>TESTIMONIOS</h2><div class="testimonial-grid">{page.testimonials.map((testimonial: any) => <figure><blockquote>{testimonial.quote}</blockquote><figcaption><img src={testimonial.image.src} alt={testimonial.image.alt} loading="lazy" /><div><strong>{testimonial.name}</strong><span>{testimonial.role}</span></div></figcaption></figure>)}</div></section>}
    {page.faq.length > 0 && <section class="content-section"><h2>PREGUNTAS FRECUENTES</h2><div class="faq-list">{page.faq.map((question: any) => <details><summary>{question.title}</summary><div class="rich-copy" set:html={question.html} /></details>)}</div></section>}
  </article>
  <PreviewContact extra={page.contactExtra} />
</main>
<SiteFooter />
